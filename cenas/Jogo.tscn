[sub_resource type="GDScript" id="GDScript_0b3n2"]
script/source = "extends Node2D

@onready var pause_menu: Control = $CanvasLayer/pause_menu
@onready var question_screen: CanvasLayer = $question_screen

func _ready() -> void:
	pause_menu.hide()
	
# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta: float) -> void:
	#if Input.is_action_just_pressed(\"pause\"):
		#print(\"oi22\")
		#get_tree().paused = true
		#pause_menu.show()

func _on_gatilho_pergunta_body_entered(body: Node2D) -> void:
	# Verifica se quem entrou na área foi realmente o Player
	if body.name == \"Player\":
		$GatilhoPergunta/CollisionShape2D.set_deferred(\"disabled\", true)
		question_screen.show_question()
		
"

